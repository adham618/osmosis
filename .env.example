# .env.example
# Copy this file to .env or .env.local and fill the values

# SITE URL WITHOUT / AT THE END
NEXT_PUBLIC_SITE_URL=https://osmosis-ar.com

# Enable/disable search engine indexing (true/false)
NEXT_PUBLIC_INDEXING_ENABLED=true

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# RESEND
RESEND_API_KEY=your_resend_key

# Verified email in Resend dashboard or onboarding@resend.dev
RESEND_FROM=onboarding@resend.dev
RESEND_TO=hr@yourdomain.com
